diff -ruN /tmp/orig_rtl/src/gate_negedge_clk.sv rtl/v3c/src/gate_negedge_clk.sv
--- /tmp/orig_rtl/src/gate_negedge_clk.sv
+++ rtl/v3c/src/gate_negedge_clk.sv
@@ -11,6 +11,18 @@
     input logic EN,                // clock-gating: enable clock (active high)
     input logic CLK);             // negedge clock
 
+`ifdef VERILATOR
+logic en_latched;
+
+// Functional model of a negative-edge clock gate:
+// capture EN only while CLK is high, then gate the low phase.
+always_latch begin
+    if (CLK)
+        en_latched = EN;
+end
+
+assign ENCLK = CLK | ~en_latched;
+`else
 logic EN_dly;
 always EN_dly = #0.5 EN; // avoid (false) hold violations
 
@@ -21,6 +33,7 @@
     .Q(ENCLK),
     .E(EN_dly),
     .TE(1'b0),
-    .CPN(CLK));
+    .CPN(CLK));
+`endif
 
 endmodule
diff -ruN /tmp/orig_rtl/src/gate_posedge_clk.sv rtl/v3c/src/gate_posedge_clk.sv
--- /tmp/orig_rtl/src/gate_posedge_clk.sv
+++ rtl/v3c/src/gate_posedge_clk.sv
@@ -12,6 +12,18 @@
     input logic EN,               // clock-gating: enable clock (active high)
     input logic CLK);             // posedge clock
 
+`ifdef VERILATOR
+logic en_latched;
+
+// Functional model of a positive-edge clock gate:
+// capture EN only while CLK is low, then gate the high phase.
+always_latch begin
+    if (!CLK)
+        en_latched = EN;
+end
+
+assign ENCLK = CLK & en_latched;
+`else
 logic EN_dly;
 always @(EN) EN_dly = #1.5 EN; //DG: required to suppress timing violations
 //this is clearly acceptable only if the EN is generated by the same clock we are gating
@@ -22,6 +34,7 @@
     .Q(ENCLK),
     .TE(1'b0),
     .E(EN_dly),
-    .CP(CLK));
+    .CP(CLK));
+`endif
 
 endmodule
